[Thumbnailer Entry]
TryExec=/usr/bin/ncrs-thumbnailer
Exec=/usr/bin/ncrs-thumbnailer %s %u %o
MimeType=application/pdf;application/x-bzpdf;application/x-ext-pdf;application/x-gzpdf;application/x-xzpdf;image/jpeg;image/png;image/gif;image/webp;image/bmp;image/svg+xml;image/tiff;image/heif;image/heic;
