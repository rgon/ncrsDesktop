#!/usr/bin/env python3
"""ncrs RAW thumbnailer.

Registered via /usr/share/thumbnailers/cr3.thumbnailer for all common camera
RAW formats.  The daemon already fetches Nextcloud previews proactively when
directories are listed; this script is the fallback for files not yet in the
XDG thumbnail cache.

Priority order:

  1. XDG cache hit — daemon pre-fetched it; just copy to %o.
  2a. STATUS says file is local → exiftool embedded preview (fast, no NC call).
  2b. STATUS says file is remote → THUMBNAIL IPC: daemon fetches NC preview.
"""
import hashlib
import os
import socket
import subprocess
import sys
from urllib.parse import unquote

import gi
gi.require_version('GdkPixbuf', '2.0')
from gi.repository import GdkPixbuf


def ipc(cmd, timeout=10):
    sock = os.path.join(
        os.environ.get('XDG_RUNTIME_DIR') or f'/run/user/{os.getuid()}',
        'ncrs.sock',
    )
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(timeout)
            s.connect(sock)
            s.sendall((cmd + '\n').encode())
            return s.makefile('rb').readline().decode(errors='replace').strip()
    except Exception:
        return None


def main():
    size    = int(sys.argv[1])
    src_uri = sys.argv[2]   # file:// URI, percent-encoded
    dst     = sys.argv[3]   # output path Nautilus will read

    src_path = unquote(src_uri[7:] if src_uri.startswith('file://') else src_uri)

    CACHE_HOME = os.environ.get('XDG_CACHE_HOME', os.path.expanduser('~/.cache'))
    xdg_dir  = os.path.join(CACHE_HOME, 'thumbnails', 'normal')
    xdg_path = os.path.join(xdg_dir, hashlib.md5(src_uri.encode()).hexdigest() + '.png')

    def write_thumbnail(pixbuf):
        w, h   = pixbuf.get_width(), pixbuf.get_height()
        long   = max(w, h)
        if long > size:
            if w >= h:
                pixbuf = pixbuf.scale_simple(size, max(1, size * h // w), GdkPixbuf.InterpType.BILINEAR)
            else:
                pixbuf = pixbuf.scale_simple(max(1, size * w // h), size, GdkPixbuf.InterpType.BILINEAR)
        mtime = str(int(os.stat(src_path).st_mtime))
        pixbuf.savev(dst, 'png',
                     ['tEXt::Thumb::URI', 'tEXt::Thumb::MTime'],
                     [src_uri, mtime])

    # ── 1. XDG cache hit (daemon pre-fetched) ─────────────────────────────────────
    if os.path.exists(xdg_path):
        try:
            write_thumbnail(GdkPixbuf.Pixbuf.new_from_file(xdg_path))
            sys.exit(0)
        except Exception:
            pass  # corrupted cache entry — fall through

    # ── 2. Route based on whether the file is locally available ───────────────────
    # Ask STATUS first (cheap, usually instant) to decide between the fast local
    # path (exiftool) and the slow remote path (THUMBNAIL fetches from NC server).
    # None (daemon slow/down) is treated as non-remote: exiftool is tried first,
    # and if the file truly isn't local, the FUSE read will fail and exiftool exits
    # non-zero — no silent download triggered.
    status = ipc(f'STATUS {src_path}', timeout=3)
    is_remote = status in ('remote', 'downloading')

    if is_remote:
        # ── 2b. Remote file: ask daemon to fetch preview from Nextcloud ───────────
        reply = ipc(f'THUMBNAIL {src_path}', timeout=15)
        if reply == 'ok' and os.path.exists(xdg_path):
            try:
                write_thumbnail(GdkPixbuf.Pixbuf.new_from_file(xdg_path))
                sys.exit(0)
            except Exception:
                pass
        sys.exit(1)

    # ── 2a. Local file: extract embedded JPEG preview via exiftool ────────────────
    try:
        result = subprocess.run(
            ['exiftool', '-b', '-PreviewImage', src_path],
            capture_output=True,
            timeout=30,
        )
    except (subprocess.TimeoutExpired, OSError):
        sys.exit(1)

    if result.returncode != 0 or not result.stdout:
        sys.exit(1)

    try:
        loader = GdkPixbuf.PixbufLoader.new_with_type('jpeg')
        loader.write(result.stdout)
        loader.close()
        pixbuf = loader.get_pixbuf()
        if not pixbuf:
            sys.exit(1)
        write_thumbnail(pixbuf)
    except Exception:
        sys.exit(1)


if __name__ == '__main__':
    main()
