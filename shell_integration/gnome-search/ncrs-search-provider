#!/usr/bin/env python3
"""
GNOME Shell Search Provider for ncRS.

Exposes Nextcloud server-side search results in the GNOME Activities
overview (Super key).  Communicates with the ncRS daemon over its Unix
socket using the SEARCH IPC command.

Install:
  ./install.sh
  Then restart GNOME Shell (log out/in, or Alt+F2 → r on X11).
"""

import json
import os
import socket
import subprocess
import sys
from html import escape as html_escape

import gi
gi.require_version("Gio", "2.0")
gi.require_version("GLib", "2.0")
from gi.repository import Gio, GLib  # noqa: E402

BUS_NAME = "es.rgon.ncrs.SearchProvider"
OBJECT_PATH = "/es/rgon/ncrs/SearchProvider"

SEARCH_PROVIDER_IFACE = "org.gnome.Shell.SearchProvider2"

IFACE_XML = """
<node>
  <interface name="org.gnome.Shell.SearchProvider2">
    <method name="GetInitialResultSet">
      <arg direction="in"  type="as" name="terms"/>
      <arg direction="out" type="as"/>
    </method>
    <method name="GetSubsearchResultSet">
      <arg direction="in"  type="as" name="previous_results"/>
      <arg direction="in"  type="as" name="terms"/>
      <arg direction="out" type="as"/>
    </method>
    <method name="GetResultMetas">
      <arg direction="in"  type="as" name="identifiers"/>
      <arg direction="out" type="aa{sv}"/>
    </method>
    <method name="ActivateResult">
      <arg direction="in"  type="s" name="identifier"/>
      <arg direction="in"  type="as" name="terms"/>
      <arg direction="in"  type="u" name="timestamp"/>
    </method>
    <method name="LaunchSearch">
      <arg direction="in"  type="as" name="terms"/>
      <arg direction="in"  type="u" name="timestamp"/>
    </method>
  </interface>
</node>
"""

SOCKET_TIMEOUT = 10.0


def _sock_path():
    runtime = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    return os.path.join(runtime, "ncrs.sock")


def _ipc_search(term):
    sp = _sock_path()
    if not os.path.exists(sp):
        return []
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(SOCKET_TIMEOUT)
            s.connect(sp)
            s.sendall(f"SEARCH {term}\n".encode())
            buf = b""
            while b"\n" not in buf and len(buf) < 256 * 1024:
                chunk = s.recv(8192)
                if not chunk:
                    break
                buf += chunk
            data = buf.decode(errors="replace").strip()
            if data.startswith("error") or not data:
                return []
            return json.loads(data)
    except Exception as e:
        print(f"[ncrs-search] IPC error: {e}", file=sys.stderr)
        return []


def _load_mount_point():
    config_home = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    config_path = os.path.join(config_home, "ncrs", "config.yaml")
    try:
        with open(config_path) as f:
            for line in f:
                stripped = line.strip()
                if stripped.startswith("mount_point:"):
                    val = stripped[len("mount_point:"):].strip().strip('"').strip("'")
                    if val:
                        return val.rstrip("/")
    except (OSError, ValueError):
        pass
    return None


class NcrsSearchProvider:
    def __init__(self):
        self._results = {}
        self._mount = _load_mount_point()

    def _do_search(self, terms):
        query = " ".join(terms).strip()
        if len(query) < 3:
            return []
        groups = _ipc_search(query)
        self._results.clear()
        ids = []
        for group in groups:
            provider_name = group.get("provider_name", "")
            provider_id = group.get("provider_id", "")
            for entry in group.get("entries", []):
                rid = entry.get("resource_url", "") or entry.get("title", "")
                if not rid:
                    continue
                self._results[rid] = {
                    "entry": entry,
                    "provider_name": provider_name,
                    "provider_id": provider_id,
                }
                ids.append(rid)
        return ids

    def GetInitialResultSet(self, terms):
        return self._do_search(terms)

    def GetSubsearchResultSet(self, _previous, terms):
        return self._do_search(terms)

    def GetResultMetas(self, ids):
        metas = []
        for rid in ids:
            info = self._results.get(rid)
            if not info:
                continue
            entry = info["entry"]
            title = entry.get("title", "")
            subline = entry.get("subline", "")
            provider_name = info["provider_name"]
            desc = f"{subline} — {provider_name}" if subline else provider_name

            meta = {
                "id": GLib.Variant("s", rid),
                "name": GLib.Variant("s", title),
                "description": GLib.Variant("s", desc),
            }

            icon_url = entry.get("icon", "")
            if icon_url:
                meta["gicon"] = GLib.Variant("s", icon_url)
            else:
                meta["gicon"] = GLib.Variant("s", "system-search-symbolic")

            metas.append(meta)
        return metas

    def ActivateResult(self, rid, _terms, _timestamp):
        info = self._results.get(rid)
        if not info:
            return

        entry = info["entry"]
        provider_id = info["provider_id"]
        url = entry.get("resource_url", "")

        if provider_id == "files" and self._mount:
            title = entry.get("title", "")
            subline = entry.get("subline", "")
            if subline:
                clean = subline.removeprefix("in ").strip().strip("/")
                local = os.path.join(self._mount, clean, title) if clean else os.path.join(self._mount, title)
            else:
                local = os.path.join(self._mount, title)
            if os.path.exists(local):
                try:
                    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
                    bus.call_sync(
                        "org.freedesktop.FileManager1",
                        "/org/freedesktop/FileManager1",
                        "org.freedesktop.FileManager1",
                        "ShowItems",
                        GLib.Variant("(ass)", ([f"file://{local}"], "")),
                        None,
                        Gio.DBusCallFlags.NONE,
                        -1,
                        None,
                    )
                    return
                except Exception:
                    pass

        if url:
            try:
                subprocess.Popen(
                    ["xdg-open", url],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                )
            except Exception as e:
                print(f"[ncrs-search] open error: {e}", file=sys.stderr)

    def LaunchSearch(self, terms, _timestamp):
        pass


def on_bus_acquired(connection, name):
    provider = NcrsSearchProvider()
    node_info = Gio.DBusNodeInfo.new_for_xml(IFACE_XML)

    def handle_method(connection, sender, object_path, interface_name, method_name, parameters, invocation):
        try:
            if method_name == "GetInitialResultSet":
                terms = parameters.unpack()[0]
                result = provider.GetInitialResultSet(terms)
                invocation.return_value(GLib.Variant("(as)", (result,)))
            elif method_name == "GetSubsearchResultSet":
                previous, terms = parameters.unpack()
                result = provider.GetSubsearchResultSet(previous, terms)
                invocation.return_value(GLib.Variant("(as)", (result,)))
            elif method_name == "GetResultMetas":
                ids = parameters.unpack()[0]
                metas = provider.GetResultMetas(ids)
                invocation.return_value(GLib.Variant("(aa{sv})", (metas,)))
            elif method_name == "ActivateResult":
                rid, terms, timestamp = parameters.unpack()
                provider.ActivateResult(rid, terms, timestamp)
                invocation.return_value(None)
            elif method_name == "LaunchSearch":
                terms, timestamp = parameters.unpack()
                provider.LaunchSearch(terms, timestamp)
                invocation.return_value(None)
            else:
                invocation.return_dbus_error(
                    "org.freedesktop.DBus.Error.UnknownMethod",
                    f"Unknown method: {method_name}",
                )
        except Exception as e:
            print(f"[ncrs-search] D-Bus handler error: {e}", file=sys.stderr)
            invocation.return_dbus_error(
                "org.freedesktop.DBus.Error.Failed",
                str(e),
            )

    connection.register_object(
        OBJECT_PATH,
        node_info.interfaces[0],
        handle_method,
        None,
        None,
    )


def on_name_lost(connection, name):
    loop.quit()


loop = GLib.MainLoop()

Gio.bus_own_name(
    Gio.BusType.SESSION,
    BUS_NAME,
    Gio.BusNameOwnerFlags.NONE,
    on_bus_acquired,
    None,
    on_name_lost,
)

loop.run()
