[Unit]
Description=ncRS Nextcloud virtual filesystem
Documentation=https://github.com/rgon/ncrsDesktop
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/ncrs
Restart=on-failure
# Programs on the mount block (rather than fail) while it restarts — see below —
# so come back quickly.
RestartSec=3
# Daemon-restart survival: ncrs parks its live FUSE descriptor in the fd store
# (sd_notify FDSTORE=1) and takes it back from LISTEN_FDS after a crash or a
# `systemctl --user restart`, so the mount and open files survive. NotifyAccess
# is what exports NOTIFY_SOCKET to a Type=simple service.
NotifyAccess=main
FileDescriptorStoreMax=4

[Install]
WantedBy=default.target
