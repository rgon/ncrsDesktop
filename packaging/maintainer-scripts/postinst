#!/bin/sh
set -e

case "$1" in
    configure)
        # ncrs.service is no longer enabled by default (the GUI tray app
        # autostarts via /etc/xdg/autostart instead). Clean up the global
        # enable left by <= 0.1.0 installs (the last version whose postinst
        # enabled it); leave it alone on later upgrades so an admin's
        # deliberate global enable survives.
        if [ -n "$2" ] && dpkg --compare-versions "$2" lt "0.1.1"; then
            if command -v systemctl >/dev/null 2>&1 && systemctl is-system-running --quiet 2>/dev/null; then
                systemctl --global disable ncrs.service || true
            fi
        fi
        # Grant CAP_SYS_ADMIN via a file capability so ncrs — an ordinary
        # per-user process, not root or setuid — can use kernel
        # FUSE_PASSTHROUGH (zero-copy reads for fully-cached files, Linux
        # 6.9+). Best-effort: setcap comes from libcap2-bin, a Recommends
        # (not a hard Depends), so its absence is expected on minimal
        # installs. ncrs detects the missing capability itself at runtime
        # and falls back to normal reads, so this is never fatal to the
        # install. A daemon already running from a previous version must be
        # restarted (e.g. via the tray menu or `systemctl --user restart
        # ncrs.service`) before it picks up the new capability.
        if command -v setcap >/dev/null 2>&1; then
            setcap cap_sys_admin+ep /usr/bin/ncrs || \
                echo "ncrs: setcap failed — FUSE passthrough will stay disabled (buffered reads still work normally)" >&2
        fi
        # Register the nc:// URI handler and other desktop entries
        if command -v update-desktop-database >/dev/null 2>&1; then
            update-desktop-database -q /usr/share/applications || true
        fi
        # Refresh MIME info cache
        if command -v update-mime-database >/dev/null 2>&1; then
            update-mime-database /usr/share/mime || true
        fi
        # Refresh icon cache for the ncrs hicolor icons
        if command -v gtk-update-icon-cache >/dev/null 2>&1; then
            gtk-update-icon-cache -q /usr/share/icons/hicolor || true
        fi
        ;;
esac

