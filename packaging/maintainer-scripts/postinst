#!/bin/sh
set -e

# Reload Nautilus so the extension is picked up immediately. Only quits
# instances that are already running; reads each process's own D-Bus address
# so this works correctly from a root postinst.
reload_nautilus() {
    if command -v nautilus >/dev/null 2>&1 && command -v runuser >/dev/null 2>&1; then
        for user in $(who | awk '{print $1}' | sort -u); do
            uid=$(id -u "$user" 2>/dev/null) || continue
            pid=$(pgrep -u "$uid" -x nautilus 2>/dev/null | head -1) || true
            [ -n "$pid" ] || continue
            dbus=$(grep -z DBUS_SESSION_BUS_ADDRESS /proc/"$pid"/environ 2>/dev/null \
                   | tr '\0' '\n' | grep '^DBUS_SESSION_BUS_ADDRESS=' \
                   | sed 's/^DBUS_SESSION_BUS_ADDRESS=//') || true
            [ -n "$dbus" ] || continue
            DBUS_SESSION_BUS_ADDRESS="$dbus" runuser -u "$user" -- nautilus -q 2>/dev/null || true
        done
    fi
}

# Reload Dolphin so the overlay plugin is picked up immediately. Dolphin only
# reads plugins at process startup (see shell_integration/file-managers/
# dolphin/README.md), so a running instance has to be quit; nothing relaunches
# it for the user, same as reload_nautilus above. Prefers kquitapp6 (KF6) and
# falls back to kquitapp5 (KF5); only touches instances already running.
reload_dolphin() {
    if command -v kquitapp6 >/dev/null 2>&1; then
        kquit=kquitapp6
    elif command -v kquitapp5 >/dev/null 2>&1; then
        kquit=kquitapp5
    else
        return 0
    fi
    command -v runuser >/dev/null 2>&1 || return 0
    for user in $(who | awk '{print $1}' | sort -u); do
        uid=$(id -u "$user" 2>/dev/null) || continue
        pid=$(pgrep -u "$uid" -x dolphin 2>/dev/null | head -1) || true
        [ -n "$pid" ] || continue
        dbus=$(grep -z DBUS_SESSION_BUS_ADDRESS /proc/"$pid"/environ 2>/dev/null \
               | tr '\0' '\n' | grep '^DBUS_SESSION_BUS_ADDRESS=' \
               | sed 's/^DBUS_SESSION_BUS_ADDRESS=//') || true
        [ -n "$dbus" ] || continue
        DBUS_SESSION_BUS_ADDRESS="$dbus" runuser -u "$user" -- "$kquit" dolphin 2>/dev/null || true
    done
}

# FUSE passthrough (zero-copy reads of fully cached files, Linux 6.9+) needs
# CAP_SYS_ADMIN for exactly two ioctls on the FUSE device. Only the small
# helper that does those ioctls gets it, as a file capability; the ncrs service
# itself runs with none, so it mounts through fusermount3 (and its checks) and
# a compromise of the network-facing daemon is not root. Best-effort: setcap
# comes from libcap2-bin, a Recommends — when it arrives later, its dpkg
# trigger brings us back here. Without the capability ncrs detects it at
# runtime and uses normal buffered reads, so this is never fatal. A daemon
# already running picks the change up on its next (re)start.
apply_caps() {
    helper=/usr/libexec/ncrs/ncrs-passthrough
    if ! command -v setcap >/dev/null 2>&1; then
        echo "ncrs: setcap not found (libcap2-bin) — FUSE passthrough stays disabled (buffered reads still work normally)" >&2
        return 0
    fi
    # Older packages put the capability on /usr/bin/ncrs itself. dpkg replaces
    # the file on upgrade, which drops it, but a hand-applied one would survive
    # a reconfigure: strip it, because a capable daemon bypasses fusermount3.
    if getcap /usr/bin/ncrs 2>/dev/null | grep -q 'cap_'; then
        setcap -r /usr/bin/ncrs || echo "ncrs: could not remove the capability from /usr/bin/ncrs — remove it with: setcap -r /usr/bin/ncrs" >&2
    fi
    # `=ep` sets exactly this capability (`+ep` would add to whatever is there);
    # getcap confirms it stuck (setcap can "succeed" on a filesystem that
    # silently drops security.* xattrs).
    if setcap cap_sys_admin=ep "$helper" && getcap "$helper" 2>/dev/null | grep -q 'cap_sys_admin[=+]ep'; then
        :
    else
        echo "ncrs: could not grant CAP_SYS_ADMIN to $helper — FUSE passthrough stays disabled (buffered reads still work normally)" >&2
    fi
}

# Raise a sysctl to at least $2 now, without waiting for the next boot to apply
# /usr/lib/sysctl.d/05-ncrs-quic.conf. Only ever raises: a value already at or
# above $2 (an admin's choice) is left alone, which `sysctl -p` on the file would
# not do. Best-effort — in a container /proc/sys is usually read-only.
raise_sysctl() {
    cur=$(sysctl -n "$1" 2>/dev/null) || return 0
    [ "$cur" -lt "$2" ] 2>/dev/null || return 0
    sysctl -q -w "$1=$2" >/dev/null 2>&1 || \
        echo "ncrs: could not raise $1 to $2 — HTTP/3 downloads may drop packets until it is" >&2
}

case "$1" in
    configure)
        # Room for the QUIC download sockets' 4 MiB buffers (see the conf file).
        if command -v sysctl >/dev/null 2>&1; then
            raise_sysctl net.core.rmem_max 4194304
            raise_sysctl net.core.wmem_max 4194304
        fi
        # ncrs.service must not be enabled globally: the GUI tray app
        # autostarts via /etc/xdg/autostart and starts the user service on
        # demand (`systemctl --user start ncrs.service`), which is what keeps
        # the mount alive across daemon restarts. Clean up the global enable
        # left by <= 0.1.0 installs (the last version whose postinst enabled
        # it); leave it alone on later upgrades so an admin's deliberate
        # global enable survives.
        if [ -n "$2" ] && dpkg --compare-versions "$2" lt "0.1.1"; then
            if command -v systemctl >/dev/null 2>&1 && systemctl is-system-running --quiet 2>/dev/null; then
                systemctl --global disable ncrs.service || true
            fi
        fi
        apply_caps
        # Register the nc:// URI handler and other desktop entries
        if command -v update-desktop-database >/dev/null 2>&1; then
            update-desktop-database -q /usr/share/applications || true
        fi
        # Refresh MIME info cache
        if command -v update-mime-database >/dev/null 2>&1; then
            update-mime-database /usr/share/mime || true
        fi
        # Refresh icon cache for the ncrs hicolor icons
        if command -v gtk-update-icon-cache >/dev/null 2>&1; then
            gtk-update-icon-cache -q /usr/share/icons/hicolor || true
        fi
        reload_nautilus
        # The Dolphin plugin ships inside this package (no separate loader
        # to wait on, unlike python3-nautilus), so it's always safe to
        # reload here on every configure.
        reload_dolphin
        ;;
    triggered)
        # $2 lists the triggers that fired. setcap: libcap2-bin was installed
        # (or upgraded) after ncrs. Anything else: python3-nautilus (Suggests)
        # installed its loader after ncrs, or Nautilus itself was upgraded —
        # reload so the extension loads now.
        caps=""
        nautilus=""
        for trigger in $2; do
            case "$trigger" in
                */setcap) caps=1 ;;
                *) nautilus=1 ;;
            esac
        done
        [ -z "$caps" ] || apply_caps
        [ -z "$nautilus" ] || reload_nautilus
        ;;
esac

