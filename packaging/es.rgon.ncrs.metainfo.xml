<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>es.rgon.ncrs</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>ncRS</name>
  <summary>Mount and sync your Nextcloud as a local filesystem</summary>
  <description>
    <p>
      ncRS mounts your Nextcloud as a local FUSE filesystem with offline
      caching, real-time sync, conflict detection, and GNOME/Nautilus
      integration including a GNOME Shell search provider.
    </p>
  </description>

  <url type="homepage">https://github.com/rgon/ncrsDesktop</url>
  <developer id="es.rgon">
    <name>Gonzalo Ruiz</name>
  </developer>

  <launchable type="desktop-id">es.rgon.ncrs.desktop</launchable>
  <icon type="stock">ncrs</icon>
  <!-- Ubuntu Software (the snap-store snap) can't see the host icon theme for a
       local .deb, so without these it shows the theme's "image-missing" badge. -->
  <icon type="remote" width="64" height="64">https://raw.githubusercontent.com/rgon/ncrsDesktop/master/ncrs-gui/src-tauri/icons/64x64.png</icon>
  <icon type="remote" width="128" height="128">https://raw.githubusercontent.com/rgon/ncrsDesktop/master/ncrs-gui/src-tauri/icons/128x128.png</icon>

  <categories>
    <category>Network</category>
    <category>FileTransfer</category>
  </categories>

  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/rgon/ncrsDesktop/master/docs/screenshot1.jpg</image>
      <caption>Sync status dashboard with plugin integrations</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/rgon/ncrsDesktop/master/docs/screenshot2.jpg</image>
      <caption>Account overview and available storage</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/rgon/ncrsDesktop/master/docs/screenshot3.jpg</image>
      <caption>Nextcloud notifications forwarded to the desktop</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/rgon/ncrsDesktop/master/docs/screenshot4.jpg</image>
      <caption>Mount directory and local cache configuration</caption>
    </screenshot>
  </screenshots>

  <!-- Sends file metadata and credentials to the configured Nextcloud server -->
  <content_rating type="oars-1.1">
    <content_attribute id="social-info">mild</content_attribute>
  </content_rating>

  <!-- Desktop-only application; not designed for touch or small screens -->
  <recommends>
    <control>keyboard</control>
    <control>pointing</control>
  </recommends>
  <requires>
    <display_length compare="ge">768</display_length>
  </requires>
</component>
